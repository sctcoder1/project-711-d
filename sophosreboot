powershell -ep bypass -nop -c "$delay=60;$sec=$delay*60;$msg=('A reboot is required to complete maintenance.`n`nPlease save your work. The system will automatically restart in {0} minutes.' -f $delay); $user=(Get-CimInstance Win32_ComputerSystem).UserName; if([string]::IsNullOrEmpty($user)){ Write-Output 'No user logged in → rebooting immediately.'; shutdown /r /t 0 /c 'Automatic reboot to complete updates.' } else { Write-Output ('User logged in: {0}' -f $user); try{ msg * $msg } catch{ try{ Add-Type -AssemblyName PresentationFramework; [System.Windows.MessageBox]::Show($msg,'System Reboot Scheduled','OK','Warning') } catch{} }; shutdown /r /t $sec /c ('System will reboot in {0} minutes.' -f $delay) }"
